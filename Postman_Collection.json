{
  "info": {
    "name": "Spring Cloud Config - Taller",
    "description": "Coleccion de pruebas para el Collection Runner de Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8888"
    }
  ],
  "item": [
    {
      "name": "Config Server - Perfil Default",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Codigo de estado 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Perfil es default', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.profiles[0]).to.eql('default');",
              "});",
              "",
              "pm.test('Contiene loan-service.properties', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.propertySources[0].name).to.include('loan-service.properties');",
              "});",
              "",
              "pm.test('Mensaje es Bienvenido Desde El Perfil Por Defecto', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.propertySources[0].source['application.message']).to.eql('Bienvenido Desde El Perfil Por Defecto');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/loan-service/default",
          "host": ["{{baseUrl}}"],
          "path": ["loan-service", "default"]
        }
      }
    },
    {
